# Copy this file to .env and fill in your project values.
# Pass it with --dart-define-from-file=.env when running or building.
# .env is gitignored; never commit real keys.
#
# The publishable key is safe to ship to clients. The database password and
# the service_role/secret key are server-only and must never appear here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
